# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =============================================================================
# EMAIL / SMTP / GMAIL CONFIGURATION
# =============================================================================
# For Gmail SMTP: MAIL_HOST="smtp.gmail.com", MAIL_PORT="465", MAIL_SECURE="true"
# For Gmail App Password: create a 16-character App Password at myaccount.google.com/apppasswords
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="SSDigitalBD.shop <noreply@ssdigitalbd.shop>"

# =============================================================================
# OFFICIAL WHATSAPP CLOUD API (META FOR DEVELOPERS)
# =============================================================================
# From developers.facebook.com -> WhatsApp -> API Setup:
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Webhook verification token configured in Meta App Dashboard:
WHATSAPP_WEBHOOK_VERIFY_TOKEN="ssdigitalbd_wa_verify_token"

# =============================================================================
# FASTSMS BANGLADESH GATEWAY (OPTIONAL SMS FALLBACK)
# =============================================================================
FASTSMS_API_URL=""
FASTSMS_API_KEY=""
FASTSMS_SENDER_ID=""
